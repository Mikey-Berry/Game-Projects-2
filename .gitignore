# every .html under tools/ is a disposable build written by prep.js, which takes the
# output name as an argument — pinning this to `game` and `prev` left any other name
# (an A/B copy built from a git revision, say) showing up as untracked. Nothing in
# tools/ is a shipped file; the game is the one at the repo root.
tools/*.html
tools/three.min.js
tools/bench-*.json
tools/*.png
node_modules/
package-lock.json
